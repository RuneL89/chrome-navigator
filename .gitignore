# Gradle
.gradle/
build/

# Wrapper bootstrap: the one-time Gradle dist used to generate the wrapper
# (the wrapper jar itself under gradle/wrapper/ IS committed).
# Also carries the EVAL-ONLY laya storage (.tools/laya-v32b/ — the demoted v32b
# checkpoint + tokenizer, NOT packaged into the APK; see PROVENANCE.txt)
.tools/

# Local config
local.properties
.env
keys.env

# IDE
.idea/
*.iml
*.ipr
*.iws

# Android
captures/
.cxx/

# OS noise
.DS_Store
Thumbs.db

# Phase 8: the ~0.5GB laya shadow model lives OUT of git (tools/fetch_laya.py rebuilds it;
# app/src/main/assets/laya/PROVENANCE.txt pins its sha256)
app/src/main/assets-local/

# Kotlin compiler session cache (transient)
.kotlin/

# ZCode session state (plans/logs)
.zcode/
.state/vision-iter/**/REPORT.md

# UAT session bulk: per-step screenshots and raw model-call evidence stay out of git
# (the *.md reports, logcat logs, and run.json/csv summaries ARE tracked; the
# phase-16-uat precedent tracked its reports only)
.state/**/shots/
.state/**/evidence/
.state/phase-17-uat/**/*.jpg
