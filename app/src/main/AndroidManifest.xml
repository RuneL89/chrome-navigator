<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 1: adds the observation service (vision 03) and the debug capture harness.
     A11y service, overlay UI and the cloud engine wiring arrived in their phases
     (vision 01 §3); the Room/ONNX training machinery was retired in PHASE_VEXP3. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 6: the LIVE harness mode speaks to the engine endpoint through :core's
         wire client (ART-2: OkHttpWireTransport stays the only HTTP speaker). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 6 harness robustness: cold-starting the browser between flake retries
         (HOME first, then kill its BACKGROUND process while the harness is foreground). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- VEXP4 D4 (live-test rerun repair, 2026-10-19): the vision readiness pre-step
         brings the browser's EXISTING task to the front (ActivityManager.moveTaskToFront)
         so the owner's page is preserved — a HOME launch reset the webview shell to
         about:blank. REORDER_TASKS is a NORMAL permission (granted at install); when the
         platform withholds the browser's task id, the pre-step falls back to the HOME
         launch, unchanged. -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Phase 6 harness gate stand-in ONLY: the debug gate-card dialog floats over Chrome
         (user-granted "display over other apps"). The PRODUCT overlays (Phase 9) are
         TYPE_ACCESSIBILITY_OVERLAY windows added by the accessibility service and need
         NO SYSTEM_ALERT_WINDOW grant — this permission never serves product UI. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Phase 9: the NavigatorService product foreground service (specialUse type). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Owner-directed harness-visibility tooling (2026-10-06, HARNESS-DEBUG ONLY — the
         product notifications are Phase 9's, with their own channel + overlay rules):
         the harness's per-step progress + final-verdict notifications on its
         `navigator-debug` channel (POST_NOTIFICATIONS is also requested at runtime,
         once, on harness launch; denial just means no notifications) and the one-shot
         run-over buzz. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package visibility (Android 11+): the harness drives the observation-allowlisted
         browsers (vision 03 §1); the loop observes exactly these packages. -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="org.chromium.webview_shell" />
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The guided setup wizard (Phase 9, phase doc §2.2): a11y enable + restricted-
             settings path, Samsung battery whitelist, key entry, model status. Re-runnable;
             MainActivity is a thin launcher onto it and the NavigatorService notification
             deep-links here. Dark-first platform theme (owner UI direction 2026-10-09):
             the app default is the platform LIGHT theme. -->
        <activity
            android:name=".setup.SetupActivity"
            android:exported="false"
            android:label="Navigator Setup"
            android:theme="@style/Theme.Navigator.Setup" />

        <!-- Debug-only navigation harness (Phase 6). Exported for adb-driven headless
             runs; it drives the loop, streams the step log, and exports run reports.
             singleTop so headless re-launches deliver onNewIntent (verifier-recommended
             2026-10-03: standard mode only brings the task to front and drops the intent). -->
        <activity
            android:name=".harness.HarnessActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Navigator Harness" />

        <!-- Debug-only capture harness (fixture recording). Exported for adb intents;
             captures are refused unless the build is debuggable. -->
        <activity
            android:name=".observe.CaptureActivity"
            android:exported="true" />

        <!-- The vision engine's adb entry (PHASE_14: part of the product app; a debug
             harness, never product UI). Exported for adb-driven runs, the
             HarnessActivity precedent. The product identity is navigator.app; the
             experiment's `.visionexp` co-install is retired. -->
        <activity
            android:name=".harness.vision.VisionExperimentActivity"
            android:exported="true"
            android:label="Navigator Vision Harness" />

        <!-- Debug-only adb capture trigger: fires while the browser stays foreground
             (refused unless the build is debuggable). -->
        <receiver
            android:name=".observe.CaptureReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="navigator.app.action.CAPTURE" />
                <action android:name="navigator.app.action.LIST" />
            </intent-filter>
        </receiver>

        <service
            android:name=".observe.NavigatorAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/navigator_accessibility_service_config" />
        </service>

        <!-- Phase 9: the product foreground service — overlay host + navigation runs.
             specialUse type per targetSdk 34+ law (subtype property declared below);
             not exported (started only from the app's own foreground components). -->
        <service
            android:name=".overlay.NavigatorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility-overlay-host-automation" />
        </service>

        <!-- Phase 9 DEBUG-ONLY overlay command + gate-runner surface: adb broadcasts
             drive the overlay windows AND run the four gate scenarios outside
             instrumentation (the JUnit shell is platform-blocked on the API 35
             emulator — measured; evidence = `logcat -s NavigatorGates`); refused
             unless the build is debuggable (the CaptureReceiver precedent). -->
        <receiver
            android:name=".overlay.OverlayDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="navigator.app.action.OVERLAY_SHOW_GOAL_INPUT" />
                <action android:name="navigator.app.action.OVERLAY_HIDE_GOAL_INPUT" />
                <action android:name="navigator.app.action.OVERLAY_SHOW_LOG" />
                <action android:name="navigator.app.action.OVERLAY_HIDE_LOG" />
                <action android:name="navigator.app.action.OVERLAY_APPEND_LINE" />
                <action android:name="navigator.app.action.OVERLAY_TOGGLE_LOG" />
                <action android:name="navigator.app.action.OVERLAY_SET_PLAN" />
                <action android:name="navigator.app.action.OVERLAY_SHOW_GATE_CARD" />
                <action android:name="navigator.app.action.OVERLAY_SHOW_COMPLETION_CARD" />
                <action android:name="navigator.app.action.OVERLAY_HIDE_CARDS" />
                <action android:name="navigator.app.action.GATE91" />
                <action android:name="navigator.app.action.GATE92" />
                <action android:name="navigator.app.action.GATE93" />
                <action android:name="navigator.app.action.GATE94" />
                <action android:name="navigator.app.action.PROBE_TOUCH_COUNT" />
            </intent-filter>
        </receiver>

        <!-- The gate scenarios' touch SENTINEL (test-only helper; blank full-screen
             activity recording touches — see the class KDoc). Not exported; same-app
             starts only. -->
        <activity
            android:name=".overlay.OverlayProbeActivity"
            android:exported="false"
            android:label="Overlay Probe" />

        <!-- V2 FEASIBILITY PROBE HARNESS (docs/V2_FEASIBILITY.md §9). DEBUG TOOLING:
             adb-launched probes for isTrusted/touch dispatch, per-site WebView behaviour,
             and off-screen WebView rendering under a specialUse foreground service.
             Exported so `adb shell am start` can drive it; the class logs under
             NavigatorProbe and writes filesDir/probe-*.txt. Removed with the V2 lane
             implementation. -->
        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:label="V2 Probe" />
        <service
            android:name=".probe.ProbeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="v2 feasibility probe (off-screen WebView rendering test)" />
        </service>

        <!-- V2 S1 - the background lane (the two-bot UI replaces LaneDebugActivity in S4;
             the release build strips this debug surface - CHG-01 gate scope). -->
        <activity
            android:name=".harness.webview.LaneDebugActivity"
            android:exported="true"
            android:label="Navigator Lane" />
        <receiver android:name=".harness.webview.LaneServiceActionReceiver" android:exported="true" />
        <service
            android:name=".harness.webview.LaneService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="v2 background web lane (off-screen WebView task execution)" />
        </service>

    </application>

</manifest>
