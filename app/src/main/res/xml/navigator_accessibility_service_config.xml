<?xml version="1.0" encoding="utf-8"?>
<!-- Observation service config (vision 03 §1). 2026-10-09 UAT R2 follow-up: the
     android:packageNames event filter was REMOVED — measured on the API 35 emulator,
     the filter does not only gate event delivery, it also strips the service's
     getWindows() window list (the IME window was invisible to the live log's IME
     watch with it set). The code-side filter stays authoritative and unchanged:
     NavigatorAccessibilityService.PACKAGE_ALLOWLIST (delegating to the pure
     BrowserPackages.ALLOWLIST) gates every observation read, and onAccessibilityEvent
     is a deliberate no-op, so unfiltered event delivery is inert. The Chromium
     webview-shell browser remains on that allowlist for the AVD's WebView Browser
     Tester (real Chrome ignores the enhanced-web-accessibility capability — additive
     and safe). packageNames was COMMA-separated when present (the platform splits on
     commas). Phase 9 adds android:canTakeScreenshot — the capability behind the goal
     input's blurred screenshot (a11y takeScreenshot, API 30+); the bitmap lives in
     memory for the input session only (ART-8). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:canRequestEnhancedWebAccessibility="true"
    android:isAccessibilityTool="true"
    android:notificationTimeout="100"
    android:description="@string/a11y_service_description"
    android:summary="@string/a11y_service_summary" />
